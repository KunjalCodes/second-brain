# ============================================================
# Application
# ============================================================

APP_NAME=ai-second-brain
APP_ENV=development
DEBUG=true

# Origin of the frontend, used to build the CORS allow-list.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Extra allowed CORS origins, comma-separated (staging, custom domains).
CORS_ORIGINS=

# Vercel preview deployments (Phase 9, ADR 0022): OFF by default. When enabled
# it admits ONLY the named project's previews (<project>-*.vercel.app) -- the old
# behaviour of admitting every *.vercel.app site as a credentialed origin was
# removed. CORS_ALLOW_VERCEL_PREVIEWS=true without CORS_VERCEL_PROJECT refuses
# to start.
CORS_ALLOW_VERCEL_PREVIEWS=false
CORS_VERCEL_PROJECT=

# Optional path prefix for every route, e.g. /api. Empty means routes are at the root.
API_PREFIX=

# NOTE: the backend never binds a port itself. Managed hosts supply $PORT:
#   uvicorn app.main:app --host 0.0.0.0 --port $PORT


# ============================================================
# LLM  (Phase 2)
# ============================================================

# "fake" is a first-class provider (app.llm.fake.FakeLLMClient): leave this unset
# or "fake" to run the whole system -- including extraction -- with no API key, no
# network access and no cost. This is what the test suite always uses. Set to
# "gemini" for real extraction; "openai"/"anthropic" are accepted by config
# validation but have no adapter yet (docs/adr/0007).
LLM_PROVIDER=fake
# Pin the exact model id here, never in code, once LLM_PROVIDER=gemini.
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=


# ============================================================
# Extraction  (Phase 2, docs/adr/0008)
# ============================================================

# Kill switch: conversations work identically either way -- extraction is an
# asynchronous enhancement, never a request dependency.
EXTRACTION_ENABLED=true
EXTRACTION_PROMPT_VERSION=v1
EXTRACTION_SCHEMA_VERSION=v1
# How many recent messages of context one extraction call sees.
EXTRACTION_WINDOW_SIZE=6
# Messages shorter than this never reach the LLM (the heuristic gate).
EXTRACTION_MIN_MESSAGE_CHARS=25
EXTRACTION_MAX_ATTEMPTS=3
# Before the sweep reclaims a job whose worker appears to have died.
EXTRACTION_LEASE_SECONDS=600
EXTRACTION_SWEEP_BATCH_SIZE=50
EXTRACTION_SWEEP_LOOKBACK_DAYS=7
EXTRACTION_RECHECK_SKIPPED=true

# Guards POST /internal/extraction/sweep and POST /internal/embeddings/backfill
# (Phase 3), neither of which is user-scoped and neither of which may ever be
# exposed publicly. Required for those endpoints to work at all; leave unset to
# disable them (they fail closed, not open).
INTERNAL_API_TOKEN=


# ============================================================
# Embeddings  (Phase 3, ADR 0009)
# ============================================================

# "fake" is a first-class provider, same rationale as LLM_PROVIDER=fake: the
# whole system -- including semantic duplicate detection and vector retrieval --
# runs end to end with no provider account and no network access. This is what
# the test suite always uses. Set to "gemini" for real embeddings.
EMBEDDING_PROVIDER=fake
# Pin the exact model id here, never in code, once EMBEDDING_PROVIDER=gemini.
EMBEDDING_MODEL=
# Must match the pgvector column's declared width (migration
# 6202eeca7d8d_phase3_memory_embeddings); Database.connect() asserts this at
# startup. Changing it requires a new migration, not just this variable.
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=3
# Bounded batch size for the embedding backfill sweep (per user, per tick).
EMBEDDING_BACKFILL_BATCH_SIZE=50

# Semantic evidence thresholds (cosine similarity, [0,1]). Configuration, not
# tuned constants -- expected to be adjusted against evaluation results
# (eval/runner.py), not guessed once and left alone.
SEMANTIC_DUPLICATE_THRESHOLD=0.90
SEMANTIC_FLAG_THRESHOLD=0.80
SEMANTIC_ENTITY_FLAG_THRESHOLD=0.85

# Hybrid retrieval ranking weights -- an explicit linear formula, never a
# learned reranker (PHASE3_PLAN.md section 8.1). Not normalized to sum to 1.
RETRIEVAL_WEIGHT_VECTOR=1.0
RETRIEVAL_WEIGHT_GRAPH=1.0
RETRIEVAL_WEIGHT_KEYWORD=0.5
RETRIEVAL_WEIGHT_RECENCY=0.2
RETRIEVAL_WEIGHT_TEMPORAL=0.5
RETRIEVAL_WEIGHT_CONFIDENCE=0.3
RETRIEVAL_TOP_K=10

# Multi-hop graph retrieval (Phase 4, PHASE4_PLAN.md sections 1-4/14). Default
# hops=2, hard max=3 enforced by the setting's own bound (not just a default).
# decay_rate is exponential: decay_rate ** hops, hop 0 = 1.0. max_nodes bounds
# a single neighbourhood traversal's result size (Cypher's own LIMIT) -- the
# dense-graph benchmark (100/1k/10k synthetic nodes) found the real scaling
# bottleneck was a missing Neo4j index (fixed in app/graph/schema.py), not
# fan-out, so no additional fan-out cap was added.
RETRIEVAL_GRAPH_HOPS=2
RETRIEVAL_GRAPH_DECAY_RATE=0.5
RETRIEVAL_GRAPH_MAX_NODES=200

# Agent (Phase 5, docs/PHASE5_PLAN.md). AGENT_WRITE_ENABLED gates
# propose_memory_update specifically -- read-only tools are governed by
# AGENT_ENABLED alone. No new dependencies or API keys: the agent reuses
# LLM_PROVIDER/LLM_MODEL/GEMINI_API_KEY exactly as extraction does.
AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=6
AGENT_TOOL_TIMEOUT_SECONDS=15.0
AGENT_TURN_TIMEOUT_SECONDS=60.0
AGENT_MAX_CONTEXT_MEMORIES=25
AGENT_WRITE_ENABLED=false


# ============================================================
# PostgreSQL  (required in Phase 2 -- conversations, messages, extraction state;
# NEVER the canonical memory graph, see docs/adr/0006)
# ============================================================

# Local:         postgresql+asyncpg://localhost/ai_second_brain
# Supabase/Neon: postgresql+asyncpg://user:pw@host/db
# As with Neo4j, no localhost default in code: a silent fallback would make a
# misconfigured production deploy look healthy.
DATABASE_URL=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5


# ============================================================
# Neo4j  (required in Phase 1 -- this is the memory store)
# ============================================================

# Managed Neo4j Aura:   neo4j+s://<id>.databases.neo4j.io
# Local Neo4j:          bolt://localhost:7687
# There is deliberately no default in code: a silent fallback to localhost would
# make a misconfigured production deploy look healthy.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# The driver's default transaction retry window is 30s, which would hang an HTTP
# request through an outage. Fail fast and let the caller retry instead.
NEO4J_MAX_TRANSACTION_RETRY_TIME=5.0
NEO4J_MAX_CONNECTION_POOL_SIZE=20
NEO4J_CONNECTION_TIMEOUT=15.0


# ============================================================
# Redis / object storage -- NOT USED
# ============================================================
# The job queue is PostgreSQL (docs/PHASE11_PLAN.md section 6.3: measured
# sufficient); there is no Redis. Document bytes are local and, in staging,
# transient (deleted after ingestion; docs/PHASE11_PLAN.md section 16).
# Durable object storage is deferred to production. The former REDIS_URL /
# STORAGE_* placeholders were never read by the application and are removed.


# ============================================================
# Graph retrieval limits
# ============================================================

# Upper bound on N-hop traversal depth. Requests above this are rejected.
GRAPH_MAX_HOPS=4
SEARCH_MAX_LIMIT=200
# Phase 8 (D1): caps on GET /entities/{id}/graph; a cut sets `truncated=true`.
GRAPH_MAX_NODES=1000
GRAPH_MAX_EDGES=5000

# Memory graph exploration API (Phase 8, /graph/*). Per-request budgets a
# client may lower but never raise; each has a hard cap in app/core/config.py
# (nodes<=1000, edges<=3000, hops<=3, memories/entity<=25).
GRAPH_EXPLORE_MAX_NODES=150
GRAPH_EXPLORE_MAX_EDGES=400
GRAPH_EXPLORE_MAX_HOPS=2
GRAPH_EXPLORE_MAX_MEMORIES_PER_ENTITY=5


# ============================================================
# Authentication (Phase 9, docs/PHASE9_PLAN.md, ADRs 0020-0024)
# ============================================================
# Server-side sessions in PostgreSQL: opaque tokens, stored only as SHA-256.
# No signing secret is needed (the former AUTH_SECRET placeholder was removed --
# nothing reads it and nothing should look protected by it).
#
# AUTH_MODE: `session` (default) = identity ONLY from a verified session
# (HttpOnly cookie, or `Authorization: Bearer <token>` for scripts/tests).
# `dev_header` = the development placeholder: X-User-Id header, falling back to
# DEV_USER_ID. NOT authentication. Startup FAILS in any APP_ENV other than
# development/test if dev_header is selected.
AUTH_MODE=
# Deprecated alias of AUTH_MODE=dev_header, kept for compatibility. Setting it
# to contradict AUTH_MODE refuses to start. Leave AUTH_MODE empty and set this
# to `true` for the pre-Phase-9 local workflow.
ALLOW_USER_ID_HEADER=true
DEV_USER_ID=dev-user

# Self-service POST /auth/register. Empty = on in development/test, OFF
# everywhere else (create accounts with scripts/manage_users.py).
AUTH_REGISTRATION_ENABLED=
# Absolute lifetime / idle timeout (the idle window slides on use).
AUTH_SESSION_TTL_HOURS=168
AUTH_SESSION_IDLE_HOURS=24
AUTH_SESSION_TOUCH_SECONDS=300
AUTH_COOKIE_NAME=sb_session
# Empty = Secure off only in development/test; ALWAYS on elsewhere (a
# production-like APP_ENV with AUTH_COOKIE_SECURE=false refuses to start).
AUTH_COOKIE_SECURE=
AUTH_COOKIE_DOMAIN=
# scrypt cost (stdlib hashlib.scrypt). Default is an OWASP-listed setting;
# production-like environments require N>=2^15, r>=8, N*r*p >= 2^15*8*3.
# For N=2^17 raise AUTH_SCRYPT_MAXMEM to >= 268435456.
AUTH_SCRYPT_N=32768
AUTH_SCRYPT_R=8
AUTH_SCRYPT_P=3
AUTH_SCRYPT_MAXMEM=67108864

# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For is trusted for
# client-IP rate limiting (e.g. the Next.js proxy's address). Empty = trust none.
TRUSTED_PROXY_IPS=

# Rate limiting (PostgreSQL fixed windows, ADR 0023). Windows are fixed:
# login 15 min, register 1 h, graph/search/write 1 min, agent/message/ingest 1 h.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_REGISTER_PER_IP=5
RATE_LIMIT_GRAPH_PER_USER=120
RATE_LIMIT_SEARCH_PER_USER=120
RATE_LIMIT_AGENT_PER_USER=30
RATE_LIMIT_MESSAGE_PER_USER=120
RATE_LIMIT_INGEST_PER_USER=20
RATE_LIMIT_WRITE_PER_USER=120
# Phase 11 (D5): set false when the backend cannot see the real client IP
# (behind the Next.js rewrite / a platform load balancer -- staging). Per-IP
# login/register buckets are then replaced by explicit service-wide ceilings;
# per-email and per-user limits still apply.
# RATE_LIMIT_PER_IP=true
# RATE_LIMIT_LOGIN_GLOBAL=300
# RATE_LIMIT_REGISTER_GLOBAL=50


# ============================================================
# Phase 11 -- deployment hardening (docs/DEPLOYMENT.md)
# ============================================================
# Production-like environments (any APP_ENV other than development/test)
# REFUSE TO START unless: DATABASE_URL and NEO4J_* are set, INTERNAL_API_TOKEN
# is >= 32 random characters, DOCUMENT_STORAGE_DIR is absolute, DEBUG /
# DATABASE_ECHO are false, LOG_LEVEL is not DEBUG, origins are https:// and
# Vercel previews are off. Fake AI needs an explicit opt-in:
# ALLOW_FAKE_AI=false
# Interactive API docs (/docs, /redoc, /openapi.json); default off when
# production-like, on in development.
# EXPOSE_DOCS=
# json (default when production-like) or text.
# LOG_FORMAT=
# In-process recovery sweeper; 0 disables it.
# SWEEP_INTERVAL_SECONDS=60
# SWEEP_INITIAL_DELAY_SECONDS=5
# SWEEP_SHUTDOWN_GRACE_SECONDS=15
# Cap on non-upload request bodies (uploads use MAX_DOCUMENT_SIZE_BYTES).
# MAX_REQUEST_BODY_BYTES=1048576
# Staging storage policy: delete raw upload bytes once chunks exist.
# DOCUMENT_DELETE_BYTES_AFTER_INGESTION=false
# How long a job may wait out provider throttling (429) without spending
# retry attempts.
# LLM_THROTTLE_MAX_AGE_SECONDS=86400
# Required with CORS_ALLOW_VERCEL_PREVIEWS (development only).
# CORS_VERCEL_TEAM_SCOPE=


# ============================================================
# Observability
# ============================================================

LOG_LEVEL=INFO