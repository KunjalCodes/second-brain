# ============================================================
# Frontend (Next.js on Vercel) -- Phase 3
# ============================================================

# Base URL of the FastAPI backend. NEXT_PUBLIC_ is required for the browser to
# read it. This is the ONLY place the backend URL is configured; it must never be
# hard-coded in components.
#
#   local dev   http://localhost:8000
#   production  https://<your-backend>.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000
