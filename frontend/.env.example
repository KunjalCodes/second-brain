# ============================================================
# Memory Explorer (Next.js) -- Phase 10
# Copy to .env.local for local development. Never commit .env* files.
# ============================================================

# Where the Next.js server proxies /api/* (next.config.ts rewrite).
# SERVER-ONLY: no NEXT_PUBLIC_ prefix, so it never reaches the browser bundle.
# It is written into the build output, so set it in the BUILD environment
# (e.g. Vercel project settings) and rebuild after changing it.
#
#   local dev   http://localhost:8000
#   demo        https://<your-backend>.onrender.com
BACKEND_ORIGIN=http://localhost:8000

# Show the "Create account" link and page. The backend is authoritative: with
# AUTH_REGISTRATION_ENABLED=false it answers 404 regardless of this flag.
# Leave unset (off) for any public deployment.
# NEXT_PUBLIC_REGISTRATION_ENABLED=true
